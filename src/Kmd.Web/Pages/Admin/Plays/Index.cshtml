@page
@model Kmd.Web.Pages.Admin.Plays.IndexModel
@{
    ViewData["Title"] = "Plays";
}

<h1>Plays</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Play</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="theatreId" class="form-label">Filter by Theatre</label>
            <select name="theatreId" id="theatreId" class="form-select">
                <option value="">All Theatres</option>
                @foreach (var t in Model.Theatres)
                {
                    <option value="@t.Id" selected="@(Model.TheatreFilter == t.Id)">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Filter</button>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Theatre</th>
            <th>URL</th>
            <th>Wiki</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var play in Model.Plays)
        {
            <tr>
                <td>@play.Name</td>
                <td>@play.Theatre.Name</td>
                <td>
                    @if (!string.IsNullOrEmpty(play.Url))
                    {
                        <a href="@play.Url" target="_blank">Link</a>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(play.WikiUrl))
                    {
                        <a href="@play.WikiUrl" target="_blank">Wiki</a>
                    }
                </td>
                <td>
                    <a asp-page="Edit" asp-route-id="@play.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@play.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
