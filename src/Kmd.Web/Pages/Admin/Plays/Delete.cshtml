@page "{id:int}"
@model Kmd.Web.Pages.Admin.Plays.DeleteModel
@{
    ViewData["Title"] = "Delete Play";
}

<h1>Delete Play</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3>Are you sure you want to delete this play?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Play.Name</dd>
        <dt class="col-sm-2">Theatre</dt>
        <dd class="col-sm-10">@Model.Play.Theatre?.Name</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Play.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
