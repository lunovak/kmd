@page
@model Kmd.Web.Pages.Admin.Reservations.BySeasonModel
@{
    ViewData["Title"] = "Reservations by Season";
}

<h1>Reservations by Season</h1>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="seasonId" class="form-label">Season</label>
            <select name="seasonId" id="seasonId" class="form-select">
                @foreach (var s in Model.Seasons)
                {
                    <option value="@s.Id" selected="@(Model.SeasonId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Show</button>
        </div>
    </div>
</form>

@if (Model.SeasonId.HasValue)
{
    <p>
        <a asp-page="Create" class="btn btn-primary">Reserve for Member</a>
    </p>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Reservations.Any())
{
    var active = Model.Reservations.Count(r => r.Status == Kmd.Web.Data.ReservationStatus.Active);
    var cancelled = Model.Reservations.Count(r => r.Status == Kmd.Web.Data.ReservationStatus.Cancelled);
    var offered = Model.Reservations.Count(r => r.Status == Kmd.Web.Data.ReservationStatus.Offered);
    <p><strong>Summary:</strong> @active active, @cancelled cancelled, @offered offered</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Play</th>
            <th>Date / Time</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Reservations)
        {
            <tr class="@(r.Status == Kmd.Web.Data.ReservationStatus.Cancelled ? "table-secondary text-muted" : r.Status == Kmd.Web.Data.ReservationStatus.Offered ? "table-warning" : "")">
                <td><a asp-page="ByMember" asp-route-userId="@r.UserId">@r.User.Email</a></td>
                <td>@r.Performance.Play.Name</td>
                <td>@r.Performance.DateTime.ToString("g")</td>
                <td>@r.Status</td>
                <td>@r.CreatedDate.ToString("g")</td>
                <td>
                    @if (r.Status == Kmd.Web.Data.ReservationStatus.Active)
                    {
                        <a asp-page="Cancel" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Cancel</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
