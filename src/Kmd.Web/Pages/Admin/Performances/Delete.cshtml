@page "{id:int}"
@model Kmd.Web.Pages.Admin.Performances.DeleteModel
@{
    ViewData["Title"] = "Delete Performance";
}

<h1>Delete Performance</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3>Are you sure you want to delete this performance?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Play</dt>
        <dd class="col-sm-9">@Model.Performance.Play.Name</dd>
        <dt class="col-sm-3">Theatre</dt>
        <dd class="col-sm-9">@Model.Performance.Theatre.Name</dd>
        <dt class="col-sm-3">Date / Time</dt>
        <dd class="col-sm-9">@Model.Performance.DateTime.ToString("g")</dd>
        <dt class="col-sm-3">Capacity</dt>
        <dd class="col-sm-9">@Model.Performance.Capacity</dd>
        <dt class="col-sm-3">Active Reservations</dt>
        <dd class="col-sm-9">@Model.ActiveReservationCount</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Performance.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
