@page "{id:int}"
@model Kmd.Web.Pages.Admin.Theatres.DeleteModel
@{
    ViewData["Title"] = "Delete Theatre";
}

<h1>Delete Theatre</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3>Are you sure you want to delete this theatre?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Theatre.Name</dd>
        <dt class="col-sm-2">URL</dt>
        <dd class="col-sm-10">@Model.Theatre.Url</dd>
        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@Model.Theatre.Notes</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Theatre.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
