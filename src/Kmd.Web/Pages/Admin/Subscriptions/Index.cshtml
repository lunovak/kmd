@page
@model Kmd.Web.Pages.Admin.Subscriptions.IndexModel
@{
    ViewData["Title"] = "Subscriptions";
}

<h1>Subscriptions</h1>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="seasonId" class="form-label">Season</label>
            <select name="seasonId" id="seasonId" class="form-select">
                @foreach (var s in Model.Seasons)
                {
                    <option value="@s.Id" selected="@(Model.SeasonId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Show</button>
        </div>
    </div>
</form>

@if (Model.SeasonId.HasValue)
{
    <p>
        <a asp-page="Create" asp-route-seasonId="@Model.SeasonId" class="btn btn-primary">Add Members</a>
    </p>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Class</th>
            <th>Reservations</th>
            <th>Limit</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sub in Model.Subscriptions)
        {
            <tr>
                <td>@sub.UserEmail</td>
                <td>@sub.UserClassName</td>
                <td>@sub.ActiveReservationCount</td>
                <td>
                    <form method="post" asp-page-handler="UpdateLimit" class="d-inline">
                        <input type="hidden" name="userId" value="@sub.UserId" />
                        <input type="hidden" name="seasonId" value="@sub.SeasonId" />
                        <input name="newLimit" type="number" value="@sub.ReservationsLimit" min="1" style="width:60px" class="form-control form-control-sm d-inline-block" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="Remove" class="d-inline"
                          onsubmit="return confirm('Remove this subscription?');">
                        <input type="hidden" name="userId" value="@sub.UserId" />
                        <input type="hidden" name="seasonId" value="@sub.SeasonId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
