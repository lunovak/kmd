@page "{id:int}"
@model Kmd.Web.Pages.Admin.Seasons.DeleteModel
@{
    ViewData["Title"] = "Delete Season";
}

<h1>Delete Season</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3>Are you sure you want to delete this season?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Season.Name</dd>
        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.Season.StartDate.ToShortDateString()</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Season.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
