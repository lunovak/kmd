@page
@model Kmd.Web.Pages.Admin.Waves.IndexModel
@{
    ViewData["Title"] = "Reservation Waves";
}

<h1>Reservation Waves</h1>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="seasonId" class="form-label">Season</label>
            <select name="seasonId" id="seasonId" class="form-select">
                @foreach (var s in Model.Seasons)
                {
                    <option value="@s.Id" selected="@(Model.SeasonId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Show</button>
        </div>
    </div>
</form>

@if (Model.SeasonId.HasValue)
{
    <p>
        <a asp-page="Create" asp-route-seasonId="@Model.SeasonId" class="btn btn-primary">Create New Wave</a>
    </p>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Start Date</th>
            <th>Priority Phase (days)</th>
            <th>Cancel Before (days)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var wave in Model.Waves)
        {
            <tr>
                <td>@wave.Name</td>
                <td>@wave.StartDate.ToShortDateString()</td>
                <td>@wave.PriorityPhaseLengthDays</td>
                <td>@wave.CanCancelBeforeDays</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@wave.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@wave.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
