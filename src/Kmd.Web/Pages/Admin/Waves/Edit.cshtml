@page "{id:int}"
@model Kmd.Web.Pages.Admin.Waves.EditModel
@{
    ViewData["Title"] = "Edit Reservation Wave";
}

<h1>Edit Reservation Wave</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post">
    <input type="hidden" asp-for="Wave.Id" />
    <input type="hidden" asp-for="Wave.SeasonId" />
    <div class="mb-3">
        <label class="form-label">Season</label>
        <input class="form-control" value="@Model.Wave.Season?.Name" disabled />
    </div>
    <div class="mb-3">
        <label asp-for="Wave.Name" class="form-label"></label>
        <input asp-for="Wave.Name" class="form-control" />
        <span asp-validation-for="Wave.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Wave.StartDate" class="form-label">Start Date</label>
        <input asp-for="Wave.StartDate" class="form-control" type="date" />
        <span asp-validation-for="Wave.StartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Wave.PriorityPhaseLengthDays" class="form-label">Priority Phase Length (days)</label>
        <input asp-for="Wave.PriorityPhaseLengthDays" class="form-control" type="number" min="0" />
        <span asp-validation-for="Wave.PriorityPhaseLengthDays" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Wave.CanCancelBeforeDays" class="form-label">Can Cancel Before (days)</label>
        <input asp-for="Wave.CanCancelBeforeDays" class="form-control" type="number" min="0" />
        <span asp-validation-for="Wave.CanCancelBeforeDays" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" asp-route-seasonId="@Model.Wave.SeasonId" class="btn btn-secondary">Cancel</a>
</form>
